# ───────── Supabase ─────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Somente servidor. NUNCA prefixar com NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# ───────── Mercado Pago ─────────
# Em desenvolvimento use as credenciais de TESTE (começam com TEST-).
MERCADOPAGO_ACCESS_TOKEN=
# Public Key (é pública; usada pelo formulário seguro de cartão no navegador)
MERCADOPAGO_PUBLIC_KEY=
# "Assinatura secreta" em Suas integrações > Webhooks
MERCADOPAGO_WEBHOOK_SECRET=

# ───────── ShadowKeys (https://revenda.shadowkeys.com.br/docs) ─────────
SHADOWKEYS_API_URL=https://revenda.shadowkeys.com.br/api/v1
# Token sk_live_... criado em Painel ShadowKeys > Desenvolvedores
SHADOWKEYS_API_TOKEN=
# live (padrão) | sandbox = gera keys FICTÍCIAS "TEST-..." para testar a entrega (bloqueado em produção)
SHADOWKEYS_MODE=live

# ───────── Aplicação ─────────
APP_URL=http://localhost:3000
# 32 bytes em base64 para criptografar as keys (AES-256-GCM). NÃO perca esta chave.
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
KEYS_ENCRYPTION_SECRET=
# Protege /api/cron/* (enviado como "Authorization: Bearer <CRON_SECRET>")
CRON_SECRET=

# ───────── E-mail (Resend — opcional, mas recomendado) ─────────
RESEND_API_KEY=
EMAIL_FROM="GhostKeys <nao-responda@seudominio.com.br>"
